---
import Wordmark from "@/components/assets/Wordmark.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const links = [
  { name: "Menu", href: "/services" },
  { name: "Wash prices", href: "/pricing-simple" },
  { name: "Contact", href: "/contact" },
  { name: "System", href: "/system/overview" },
];
---

<section class="bg-sns-foam overflow-hidden">
  <Wrapper variant="standard" class="py-24">
    <div class="max-w-xl">
      <Wordmark class="text-2xl" />
      <Text
        tag="h2"
        variant="displayLG"
        class="mt-6 text-sns-espresso text-balance"
      >
        Coffee up front. Washers in the back.
      </Text>
      <p class="mt-4 font-medium text-base-600">
        Concrete, oak, and big windows. Sip while your load runs.
      </p>
      <ul role="list" class="flex flex-wrap gap-2 max-w-xl w-full mt-16">
        {
          links.map((link) => (
            <li>
              <a
                class="text-sns-espresso text-xl hover:text-accent-600 duration-300"
                href={link.href}
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Wrapper>
</section>
